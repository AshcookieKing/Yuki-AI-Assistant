{
  "name": "yuki-desktop",
  "productName": "Yuki",
  "version": "1.1.0",
  "description": "Юки — ИИ-ассистентка с 3D-аватаром",
  "author": "AshcookieKing",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ashcookieking.yuki",
    "productName": "Yuki",
    "executableName": "Yuki",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "setup.html",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "server.py",
          "requirements.txt",
          "setup.bat",
          "setup_voice.bat",
          "assistant/**/*",
          "static/**/*",
          "singer/worker.py",
          "singer/tts_worker.py",
          "!**/__pycache__/**",
          "!static/models/*.vrm"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AshcookieKing",
        "repo": "Yuki-AI-Assistant",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Юки",
      "uninstallDisplayName": "Юки — ИИ-ассистент",
      "artifactName": "Yuki-Setup-${version}.exe",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
